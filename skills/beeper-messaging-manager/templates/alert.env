# Delivery credentials for the Beeper realtime watcher.
# Copy to your automation dir (default ~/.beeper-automation/alert.env), fill in,
# then restart the watcher:  systemctl --user restart beeper-watcher   (Linux)
#
# Telegram delivery (default): create a bot with @BotFather, get your numeric
# chat id (message the bot, then read
#   https://api.telegram.org/bot<TOKEN>/getUpdates ).
BEEPER_ALERT_TG_TOKEN=
BEEPER_ALERT_TG_CHAT=

# Alternative: run any command per alert instead of Telegram. The alert text is
# piped to the command's stdin. If set, this overrides Telegram.
#   macOS desktop notification:
# ALERT_CMD=xargs -0 -I{} osascript -e 'display notification "{}" with title "Beeper"'
#   Linux desktop notification:
# ALERT_CMD=xargs -0 notify-send "Beeper"
# ALERT_CMD=
